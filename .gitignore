.idea/

# Python: entornos virtuales, cache y empaquetado
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.Python

# Herramientas de pruebas, analisis y cobertura
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Credenciales y configuracion privada: versionar solo plantillas sin secretos
/include/ConfiguracionWifi.h
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
Secrets.h
secrets.h
secrets.local.*
config.local.*
credentials.json
secrets.json
claude_desktop_config.json

# Claves privadas y almacenes de credenciales
